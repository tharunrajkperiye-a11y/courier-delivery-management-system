{% extends "base.html" %}

{% block title %}My Parcels - CourierFlow{% endblock %}

{% block content %}

<div class="page-header">

    <h1>My Parcels</h1>

    <p>
        Track and view parcels linked to your customer account.
    </p>

</div>

<div class="table-card">

    <table>

        <thead>
            <tr>
                <th>Tracking Number</th>
                <th>Receiver</th>
                <th>Destination</th>
                <th>Weight</th>
                <th>Booking Date</th>
                <th>Delivery Status</th>
            </tr>
        </thead>

        <tbody>

            {% for parcel in parcels %}

            <tr>

                <td>
                    <strong>{{ parcel.tracking_number }}</strong>
                </td>

                <td>{{ parcel.receiver_name }}</td>

                <td>{{ parcel.destination }}</td>

                <td>{{ parcel.weight }} kg</td>

                <td>{{ parcel.booking_date }}</td>

                <td>

                    {% if parcel.delivery_status == "Delivered" %}

                        <span class="status status-delivered">
                            Delivered
                        </span>

                    {% elif parcel.delivery_status == "In Transit" or parcel.delivery_status == "Out for Delivery" %}

                        <span class="status status-transit">
                            {{ parcel.delivery_status }}
                        </span>

                    {% elif parcel.delivery_status == "Cancelled" %}

                        <span class="status status-cancelled">
                            Cancelled
                        </span>

                    {% else %}

                        <span class="status status-booked">
                            {{ parcel.delivery_status }}
                        </span>

                    {% endif %}

                </td>

            </tr>

            {% else %}

            <tr>
                <td colspan="6" style="text-align: center; padding: 30px;">
                    No parcels are linked to your account yet.
                </td>
            </tr>

            {% endfor %}

        </tbody>

    </table>

</div>

{% endblock %}
